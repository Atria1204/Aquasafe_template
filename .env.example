# Salin file ini menjadi ".env" lalu ganti semua nilainya.
# File .env TIDAK BOLEH di-upload ke GitHub (sudah ada di .gitignore).

# ---- Database MySQL ----
DB_ROOT_PASSWORD=ganti_password_root
DB_NAME=aquasafe_iot
DB_USER=aquasafe
DB_PASSWORD=ganti_password_user

# ---- Backend ----
# Kunci untuk tanda tangan token login. Isi dengan teks acak panjang, contoh hasil:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti_dengan_teks_acak_panjang

# (Opsional) Kunci rahasia alat ESP32. Kalau diisi, ESP32 wajib mengirim header
# "x-device-key: <nilai ini>" (dan ESP32-CAM pakai ?key=<nilai ini> di URL websocket).
# Kosongkan kalau firmware belum mendukung.
DEVICE_API_KEY=

# (Opsional) Broker MQTT publik untuk kontrol kamera, contoh: mqtt://broker.hivemq.com:1883
# Broker publik bisa dibaca siapa saja, jadi kosongkan kalau tidak perlu.
PUBLIC_MQTT_URL=

# (Opsional) Token Cloudflare Tunnel, hanya kalau mau online lewat domain sendiri.
# Didapat dari dashboard Cloudflare > Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
