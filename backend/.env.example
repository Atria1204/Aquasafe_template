# Hanya dipakai kalau backend dijalankan TANPA docker (cd backend && npm start).
# Salin menjadi backend/.env lalu isi nilainya. Kalau pakai docker-compose, pakai .env di folder utama.
PORT=5000
DB_HOST=localhost
DB_USER=aquasafe
DB_PASS=ganti_password_user
DB_NAME=aquasafe_iot
MQTT_BROKER_URL=mqtt://localhost:1883

# Teks acak panjang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti_dengan_teks_acak_panjang

# Opsional (lihat .env.example di folder utama)
DEVICE_API_KEY=
PUBLIC_MQTT_URL=
